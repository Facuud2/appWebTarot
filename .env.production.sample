# ==============================================================================
# VARIABLES PARA VERCEL (Project Settings -> Environment Variables)
# ==============================================================================
# Copia y pega estos valores en el panel de Vercel para el entorno "Production":
#
# SESSION_SECRET: Genera una clave con: openssl rand -base64 32
SESSION_SECRET=reemplazar_con_un_secreto_aleatorio_de_al_menos_32_caracteres_123456
FORCE_SECURE_COOKIE=true

# TURSO: Obtenidos con 'turso db show <nombre> --url' y 'turso db tokens create <nombre>'
TURSO_DATABASE_URL=libsql://grimorio-tarot-tu-usuario.turso.io
TURSO_AUTH_TOKEN=tu_token_de_autenticacion_turso_aqui
